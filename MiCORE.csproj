<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>MiCORE</AssemblyName>
    <Product>MiCORE</Product>
    <Version>0.17.0</Version>
    <!-- Metadados do .exe (Propriedades › Detalhes). O SignPath confere nome do produto e versão:
         ao mudar a versão, atualize também signpath/artifact-configuration.xml. -->
    <InformationalVersion>$(Version).0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>MiCORE</AssemblyTitle>
    <Description>MiCORE - diagnóstico, benchmark, limpeza e otimização de PC para Windows</Description>
    <Company>Systecinfo</Company>
    <Authors>Systecinfo</Authors>
    <Copyright>Copyright (c) 2026 MiCORE · licença MIT</Copyright>
    <RepositoryUrl>https://github.com/Systecinfo/MiCORE</RepositoryUrl>
    <!-- Sempre otimizado: o MiCORE BENCH e os stress tests precisam do JIT otimizado também em Debug -->
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-badge.png" />
    <Resource Include="Assets\logo-dark.png" />
  </ItemGroup>

  <!-- Dependências embutidas no .exe (BundledDeps.cs): instalador do driver PawnIO (sensores da CPU, GPL-2.0),
       tabela de fabricantes por MAC (IEEE) e regras de limpeza (Winapp2). Nada proprietário vai dentro do .exe. Ver Native\LEIA-ME.md. -->
  <ItemGroup>
    <EmbeddedResource Include="Native\*" Exclude="Native\*.md" LogicalName="Native/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
  </ItemGroup>

</Project>
